# 可选FRED API key，用于高收益债利差历史与美债备用数据。
# 申请：https://fred.stlouisfed.org/docs/api/api_key.html
# 巴菲特指标采用GuruFocus上市市值口径；FRED权益/GDP只作为代理展示。
# 留空时信用利差保持缺失，可手动输入或将其权重设为0。
FRED_API_KEY=


# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# 推送时间，美东时间工作日 HH:MM，默认 10:00
NOTIFY_TIME=10:00
# 面板端口绑定地址；Linux服务器建议 127.0.0.1（见 docs/DEPLOY.md）
MONITOR_BIND=0.0.0.0
